# ===========================================================
#  config.env — ตัวแปรกลางของโปรเจค
#  คัดลอกไฟล์นี้เป็น config.env แล้วกรอกค่าให้ครบ
#      cp config.env.example config.env && chmod 600 config.env
#  !! ห้าม commit config.env ขึ้น git เพราะมีรหัสผ่าน !!
# ===========================================================

# ---------- โดเมน (DuckDNS) ----------
# ถ้าโดเมนคือ cs-buu.duckdns.org ให้ใส่แค่ "cs-buu"
DUCKDNS_SUBDOMAIN=
# token จากหน้า https://www.duckdns.org (หลัง login)
DUCKDNS_TOKEN=

# ---------- ผู้ดูแลระบบ ----------
# ชื่อ user ธรรมดาที่จะใช้ ssh เข้ามา (ห้ามใช้ root)
ADMIN_USER=sysadmin
# อีเมลสำหรับแจ้งเตือนใบรับรองหมดอายุจาก Let's Encrypt
ADMIN_EMAIL=

# public key ของสมาชิกในกลุ่ม (ใส่ได้หลายคน บรรทัดละ 1 key)
# ใช้โดยสคริปต์ 00b-create-admin-user.sh
# ตัวอย่าง: ssh-ed25519 AAAAC3Nza... pooh@laptop
SSH_PUBLIC_KEYS="
"

# ---------- SSH ----------
SSH_PORT=22
# จำกัด IP ที่ ssh เข้าได้ (คั่นด้วยช่องว่าง) เว้นว่าง = อนุญาตทุก IP ในไทย
# ตัวอย่าง: ALLOW_SSH_FROM="203.0.113.50 198.51.100.0/24"
ALLOW_SSH_FROM=""

# ---------- ฐานข้อมูล WordPress ----------
WP_DB_NAME=wordpress
WP_DB_USER=wpuser
# ตั้งรหัสยาว ๆ (สร้างด้วย: openssl rand -base64 24)
WP_DB_PASS=

# ---------- ตำแหน่งติดตั้ง ----------
# เว้นว่าง = /var/www/<DUCKDNS_SUBDOMAIN>
WP_ROOT=

# ---------- Firewall ----------
# แหล่ง CIDR ของประเทศไทย (ipdeny อัปเดตรายวัน)
TH_ZONE_URL=https://www.ipdeny.com/ipblocks/data/aggregated/th-aggregated.zone
# เปิด true ถ้า Stage 2 วางเว็บหลัง Cloudflare (ต้อง allow IP ของ Cloudflare ด้วย)
BEHIND_CLOUDFLARE=false

# ---------- fail2ban ----------
# IP ที่ห้ามแบน (คั่นด้วยช่องว่าง) เช่น IP ขาออกของมหาวิทยาลัยที่ทั้งกลุ่มใช้ร่วมกัน
F2B_IGNORE_IP=""
